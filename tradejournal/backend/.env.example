# Sao chép thành .env (KHÔNG commit .env). Mọi biến có tiền tố TJ_.
TJ_ENV=production
TJ_DATABASE_URL=postgresql+psycopg://tj:CHANGE_ME@db:5432/tradejournal
TJ_COOKIE_SECURE=true
TJ_SESSION_TTL_HOURS=336

# Lưu ảnh: local (chỉ dev) hoặc s3 (S3-compatible: AWS S3, Cloudflare R2, Backblaze B2, MinIO)
TJ_STORAGE_BACKEND=s3
TJ_S3_BUCKET=tradejournal-images
TJ_S3_ENDPOINT_URL=
TJ_S3_REGION=
TJ_S3_ACCESS_KEY_ID=
TJ_S3_SECRET_ACCESS_KEY=

TJ_MAX_UPLOAD_MB=10
TJ_MAX_IMAGES_PER_USER=5000
TJ_MAX_CSV_MB=5
TJ_MAX_CSV_ROWS=20000
TJ_AUTH_RATE_LIMIT=10
TJ_AUTH_RATE_WINDOW_S=60
