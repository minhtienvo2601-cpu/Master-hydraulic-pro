{
  "name": "boc-tach-vat-tu",
  "productName": "Boc Tach Vat Tu",
  "version": "1.0.0",
  "description": "Bóc tách vật tư từ hồ sơ thiết bị (bản Windows)",
  "author": "Minh Tien Vo",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "build:app": "node build-app.js",
    "start": "npm run build:app && electron .",
    "test": "node test/scanner.test.js",
    "dist": "npm run build:app && electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "@fontsource/be-vietnam-pro": "5.1.0",
    "@fontsource/jetbrains-mono": "5.1.1",
    "electron": "33.2.1",
    "electron-builder": "25.1.8",
    "exceljs": "4.4.0",
    "jszip": "3.10.1",
    "pdfjs-dist": "3.11.174",
    "xlsx": "0.18.5"
  },
  "build": {
    "appId": "vn.tien.boctachvattu",
    "productName": "Boc Tach Vat Tu",
    "copyright": "Minh Tien Vo",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "scanner.js",
      "app/**/*",
      "build/icon.png",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Bóc Tách Vật Tư",
      "artifactName": "BocTachVatTu-CaiDat-${version}.exe"
    },
    "portable": {
      "artifactName": "BocTachVatTu-ChayLuon-${version}.exe"
    }
  }
}
